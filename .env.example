# Copy to .env and fill in locally. Never commit credentials or Telegram sessions.
api_id=
api_hash=
bot_token=
for_whom_list=

ai_api_key=
base_url=https://api.perplexity.ai
ai_model=sonar-pro
AI_BACKEND=template
# template: no model/API; ollama: local model; perplexity: existing paid adapter.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
AI_USE_DOMAIN_FILTER=1

# Wines: stock/manual entry needs no model or extra mandatory Python packages.
# Optional local label OCR: Tesseract in PATH with these language packs installed.
# Windows also tries built-in Windows OCR with installed recognition languages.
WINE_OCR_LANG=eng
# Optional already-installed local Ollama VISION model, separate from OLLAMA_MODEL.
# Empty disables this fallback; images are never sent to cloud APIs.
WINE_VISION_MODEL=
# Exact shop domains (comma-separated); www aliases accepted, other subdomains explicit.
# Advanced custom hosts; admin connects ready Moscow profiles separately in Telegram.
# Empty permits no custom shops. No requests if both this and profiles are disabled.
# Users supply HTTPS URLs of exact products; only supported profiles provide Moscow scope.
WINE_PRICE_ALLOWED_HOSTS=

# Search indicators temporarily disabled. Code, settings and history are retained.
# google_trends or legacy must be enabled explicitly; no automatic fallback.
SEARCH_PROVIDER=disabled
WORDSTAT_OAUTH=
WORDSTAT_CLIENT_ID=
# legacy keeps the former OAuth connection; cloud uses Yandex Search API v2.
WORDSTAT_BACKEND=legacy
# For cloud: folder ID and exactly one API key or IAM token (separate from OAuth).
WORDSTAT_FOLDER_ID=
WORDSTAT_API_KEY=
WORDSTAT_IAM_TOKEN=

# Optional, defaults to disabled. Only clean main can fast-forward to origin/main.
AUTO_UPDATE=0

# Numeric Telegram user IDs allowed to administer the service (comma-separated).
ADMIN_TELEGRAM_IDS=
# Optional web UI. The Telegram service needs neither this nor a web password.
DASHBOARD_ENABLED=0
# Used only with DASHBOARD_ENABLED=1 and the separate dashboard command.
# Keep the login password only in .env; do not put it in URLs.
DASHBOARD_PASSWORD=
# Optional absolute path; default: data/ inside this checkout.
THESAURUS_DATA_DIR=
